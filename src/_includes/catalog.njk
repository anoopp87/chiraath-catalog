{% set whatsapp_backup = "919496341253" %}
{% set order_email = "chiraath.official@hotmail.com" %}

<style>
  :root{--text:#111;--muted:rgba(0,0,0,.65);--border:#eee;--border2:#ddd;--chip:#f7f7f7}
  *{box-sizing:border-box}

  body{
    margin:0;
    font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    background: linear-gradient(180deg, #faf7f2 0%, #ffffff 55%, #fbfbfb 100%);
    color:var(--text);
  }

  .wrap{
    max-width:980px;
    margin:14px auto 18px;
    padding:16px;
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 22px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }

.cover{
  width:100%;
  height:auto;
  aspect-ratio: 16 / 7;
  object-fit: cover;
  object-position: 50% 28%;
  border-radius:18px;
  border:1px solid rgba(0,0,0,0.08);
  margin-bottom:12px;
}

@media(min-width:768px){
  .cover{ height:300px; }
}

  .muted{color:var(--muted)}

  .btn{
    display:block;
    padding:12px;
    border:1px solid var(--border2);
    border-radius:14px;
    text-align:center;
    text-decoration:none;
    color:var(--text);
    margin-bottom:10px;
    font-weight:800;
    background:#fff;
  }

  .btn.whatsapp{
    background:#25D366;
    border-color:#25D366;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
  }
  .btn.whatsapp:hover{filter: brightness(0.95);}
  .btn.whatsapp svg{width:18px;height:18px;fill:#fff;flex:0 0 auto;}

  .chips{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 6px}
  .chipbtn{
    appearance:none;
    background:var(--chip);
    border:1px solid var(--border);
    border-radius:999px;
    padding:9px 12px;
    font-size:13px;
    font-weight:750;
    cursor:pointer;
  }
  .chipbtn.active{background:#111;color:#fff;border-color:#111}

  .search{margin:10px 0 8px}
  .search input{
    width:100%;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:14px;
    font-size:14px;
    background:#fff;
  }

  .sortselect{
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:14px;
    font-size:14px;
    background:#fff;
    font-weight:700;
  }

  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  @media(min-width:768px){.grid{grid-template-columns:repeat(3,1fr)}}
  @media(min-width:1024px){.grid{grid-template-columns:repeat(4,1fr)}}

  .cardlink{color:inherit;text-decoration:none;display:block}
  .card{
    border:1px solid var(--border);
    border-radius:16px;
    padding:10px;
    background:#fff;
  }
  .card:hover{border-color:#d7d7d7}

  .imgwrap{position:relative}
  .card img{
    width:100%;
    aspect-ratio:4/5;
    object-fit:cover;
    object-position:50% 18%;
    border-radius:12px;
    background:#f3f3f3;
  }

  .oos{
    position:absolute;
    top:10px;
    left:10px;
    background:#111;
    color:#fff;
    font-size:12px;
    font-weight:900;
    border-radius:999px;
    padding:6px 10px;
  }

  .code{font-size:12px;color:var(--muted);margin-top:8px}
  .price{margin-top:6px}
  .old{text-decoration:line-through;color:var(--muted);margin-right:8px}

  .title{font-size:15px;font-weight:600;line-height:1.3;}
</style>

<div class="wrap">

  {% if site.cover %}
    <img class="cover" src="{{ site.cover }}" alt="CHIRAATH cover">
  {% endif %}

  <a class="btn whatsapp" href="https://wa.me/{{ whatsapp_main }}" target="_blank" rel="noopener">
