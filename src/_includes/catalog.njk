  {% macro card(p) %}
    {% if p.data.images and p.data.images.length %}
  {% set hero = p.data.images[0] %}
{% else %}
  {% set hero = p.data.image %}
{% endif %}
    <div class="card">
      <div class="imgwrap">
        {% if hero %}
          <img src="{{ hero }}" alt="{{ p.data.title }}" loading="lazy" decoding="async">
        {% else %}
          <img src="/images/cover.jpg" alt="{{ p.data.title }}" loading="lazy" decoding="async">
        {% endif %}
        {% if p.data.in_stock == false %}
          <div class="oos">Out of stock</div>
        {% endif %}
      </div>

      <div class="code">{{ p.data.code }}</div>
      <div class="title">{{ p.data.title }}</div>

      <div class="price">
        {% if p.data.offer_price %}
          <span class="old">₹{{ p.data.price }}</span><strong>₹{{ p.data.offer_price }}</strong>
        {% else %}
          <strong>₹{{ p.data.price }}</strong>
        {% endif %}
      </div>
    </div>
  {% endmacro %}

{# ===== Global dataset for global search (ALL products) ===== #}
<script id="allProductsJson" type="application/json">
[
{% set first = true %}
{% for p in collections.productsSorted %}
  {% if not p.data.hidden %}
    {% if not first %},{% endif %}
    {% set first = false %}
    {
      "code": {{ (p.data.code or "") | dump | safe }},
      "title": {{ (p.data.title or "") | dump | safe }},
      "category": {{ (p.data.category or "") | dump | safe }},
      "url": {{ (p.url or "") | dump | safe }},
      "in_stock": {{ (p.data.in_stock != false) | dump | safe }},
      "base_price": {{ (p.data.price or 0) | dump | safe }},
      "offer_price": {{ (p.data.offer_price or 0) | dump | safe }},
      "price": {{ (p.data.offer_price or p.data.price or 0) | dump | safe }},
      "image": {{ ((p.data.images and p.data.images[0]) or p.data.image or "") | dump | safe }},
      "orig": {{ loop.index0 | dump | safe }}
    }
  {% endif %}
{% endfor %}
]
</script>

<div id="globalInfo" class="global-info" hidden></div>

  <div class="grid">
  {% for p in prods %}
    {% if not p.data.hidden %}
      {% set displayPrice = p.data.offer_price or p.data.price or 0 %}
      <div class="product-item"
           data-category="{{ p.data.category }}"
           data-stock="{% if p.data.in_stock == false %}0{% else %}1{% endif %}"
           data-search="{{ (p.data.code ~ ' ' ~ p.data.title) | lower }}"
           data-title="{{ (p.data.title or '') | lower }}"
           data-price="{{ displayPrice }}"
           data-orig="{{ loop.index0 }}">
        <a class="cardlink" href="{{ p.url }}">{{ card(p) }}</a>
      </div>
    {% endif %}
  {% endfor %}
  </div>

<nav id="pager" style="margin-top:16px; display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
  {% if pagination.href.previous %}
    <a class="btn" data-page-link style="max-width:140px" href="{{ pagination.href.previous }}">← Prev</a>
  {% endif %}

  {% for href in pagination.hrefs %}
    {% set pageNum = loop.index %}
    <a class="btn" data-page-link
       style="max-width:60px; padding:10px 0; {% if pagination.pageNumber == loop.index0 %}background:#111;color:#fff;border-color:#111{% endif %}"
       href="{{ href }}">
      {{ pageNum }}
    </a>
  {% endfor %}

  {% if pagination.href.next %}
    <a class="btn" data-page-link style="max-width:140px" href="{{ pagination.href.next }}">Next →</a>
  {% endif %}
</nav>

  <div style="margin-top:28px">
    {% include "black-footer.njk" %}
  </div>

</div>

<script>
  const grid = document.querySelector('.grid');
  const pager = document.getElementById('pager');
  const globalInfo = document.getElementById('globalInfo');

  const controlsPanel = document.getElementById('controlsPanel');
  const searchToggle = document.getElementById('searchToggle');
  const sortToggle = document.getElementById('sortToggle');
  const searchBox = document.getElementById('searchBox');
  const sortSelect = document.getElementById('sortSelect');
  const sortLabel = document.getElementById('sortLabel');
  const clearBtn = document.getElementById('clearSearch');

  // Save original paginated markup so we can restore without breaking anything
  const originalGridHTML = grid ? grid.innerHTML : '';
  const originalPagerDisplay = pager ? (pager.style.display || '') : '';

  // Parse the global dataset safely (rendered by Eleventy at build time)
  let ALL = [];
  try {
    ALL = JSON.parse(document.getElementById('allProductsJson')?.textContent || '[]');
    if (!Array.isArray(ALL)) ALL = [];
  } catch (e) {
    ALL = [];
  }

  function getItems(){
    return grid ? Array.from(grid.querySelectorAll('.product-item')) : [];
  }

  function applyFadeIn(root) {
    (root || document).querySelectorAll('.card img').forEach(img => {
      if (img.complete && img.naturalWidth > 0) {
        img.classList.add('img-loaded');
      } else {
        img.addEventListener('load', () => img.classList.add('img-loaded'), { once: true });
      }
    });
  }

  function applySort(){
    if (!grid || !sortSelect) return;

    const mode = sortSelect.value || 'newest';
    const items = getItems();

    const sorted = [...items].sort((a,b) => {
      // in-stock first
      const aStock = Number(a.dataset.stock || '1');
      const bStock = Number(b.dataset.stock || '1');
      if (aStock !== bStock) return bStock - aStock;

      if (mode === 'price_low') {
        return Number(a.dataset.price || '0') - Number(b.dataset.price || '0');
      }
      if (mode === 'price_high') {
        return Number(b.dataset.price || '0') - Number(a.dataset.price || '0');
      }
      if (mode === 'name_az') {
        return String(a.dataset.title || '').localeCompare(String(b.dataset.title || ''));
      }

      // newest (default): lower orig first
      return Number(a.dataset.orig || '0') - Number(b.dataset.orig || '0');
    });

    sorted.forEach(el => grid.appendChild(el));
    applyFadeIn(grid);
  }

  function setMode(isGlobal, q){
    if (pager) pager.style.display = isGlobal ? 'none' : (originalPagerDisplay || 'flex');

    if (globalInfo) {
      globalInfo.hidden = !isGlobal;
      if (isGlobal) {
        const count = getItems().length;
        globalInfo.textContent = count === 0
          ? `No products found for "${q}"`
          : `${count} result${count !== 1 ? 's' : ''} for "${q}"`;
      }
    }

    if (sortLabel) sortLabel.textContent = 'Sort results';
  }

  function restorePage(){
    if (!grid) return;
    grid.innerHTML = originalGridHTML;
    if (globalInfo) globalInfo.hidden = true;
    setMode(false, '');
    applySort();
  }

  function renderGlobal(q){
    if (!grid) return;

    const query = (q || '').trim().toLowerCase();
    if (!query) {
      restorePage();
      return;
    }

    const matches = ALL.filter(p => {
      const text = `${p.code || ''} ${p.title || ''}`.toLowerCase();
      return text.includes(query);
    });

    grid.innerHTML = '';

    if (matches.length === 0) {
      grid.innerHTML = `<div style="grid-column:1/-1;padding:40px 16px;text-align:center;color:var(--muted)"><div style="font-size:2rem;margin-bottom:8px">🔍</div><div style="font-weight:800;font-size:15px">No products found</div><div style="font-size:13px;margin-top:4px">Try a different name or product code</div></div>`;
      setMode(true, q);
      return;
    }

    matches.forEach(p => {
      const inStock = (p.in_stock !== false);
      const stock = inStock ? 1 : 0;

      const basePrice = Number(p.base_price || 0);
      const offerPrice = Number(p.offer_price || 0);
      const displayPrice = offerPrice > 0 ? offerPrice : basePrice;

      const title = String(p.title || '');
      const code = String(p.code || '');
      const img = p.image || '/images/cover.jpg';
      const orig = Number(p.orig || 0);

      const priceHtml = offerPrice > 0
        ? `<span class="old">₹${basePrice}</span><strong>₹${offerPrice}</strong>`
        : `<strong>₹${basePrice}</strong>`;

      const html = `
        <div class="product-item"
             data-stock="${stock}"
             data-title="${title.toLowerCase()}"
             data-search="${(code + ' ' + title).toLowerCase()}"
             data-price="${displayPrice}"
             data-orig="${orig}">
          <a class="cardlink" href="${p.url}">
            <div class="card">
              <div class="imgwrap">
                <img src="${img}" alt="${title}" loading="lazy" decoding="async">
                ${inStock ? '' : '<div class="oos">Out of stock</div>'}
              </div>
              <div class="code">${code}</div>
              <div class="title">${title}</div>
              <div class="price">${priceHtml}</div>
            </div>
          </a>
        </div>
      `;
      grid.insertAdjacentHTML('beforeend', html);
    });

    setMode(true, q);
    applySort();
  }

  function getStateFromUrl(){
    const p = new URLSearchParams(window.location.search);
    return {
      q: (p.get('q') || '').trim(),
      sort: p.get('sort') || 'newest',
    };
  }

  function setStateToUrl(q, sort){
    const p = new URLSearchParams();
    if (q && q.trim()) p.set('q', q.trim());
    if (sort && sort !== 'newest') p.set('sort', sort);

    const qs = p.toString();
    const newUrl = window.location.pathname + (qs ? `?${qs}` : '');
    history.replaceState(null, '', newUrl);

    // Preserve query params when clicking pagination (normal mode)
    document.querySelectorAll('a[data-page-link]').forEach(a => {
      const base = a.getAttribute('href').split('?')[0];
      a.setAttribute('href', base + (qs ? `?${qs}` : ''));
    });
  }

  function applyAll(pushUrl=true){
    const q = (searchBox?.value || '').trim();
    const sort = sortSelect?.value || 'newest';

    if (q) renderGlobal(q);
    else restorePage();

    if (pushUrl) setStateToUrl(q, sort);
  }

  // Controls panel behavior
function toggleControls(focusEl){
  if (!controlsPanel) return;

  const willOpen = controlsPanel.hidden;
  controlsPanel.hidden = !willOpen;

  if (willOpen && focusEl){
    setTimeout(() => {
      focusEl.focus();
      // Premium: select existing text so user can just type and replace
      if (typeof focusEl.select === 'function') focusEl.select();
    }, 0);
  }
}

  searchToggle?.addEventListener('click', () => toggleControls(searchBox));
  sortToggle?.addEventListener('click', () => toggleControls(sortSelect));
  clearBtn?.addEventListener('click', () => {
    if (searchBox) searchBox.value = '';
    applyAll(true);
  });

  searchBox?.addEventListener('input', () => applyAll(true));
  sortSelect?.addEventListener('change', () => applyAll(true));

  // Init from URL
  (function init(){
    const st = getStateFromUrl();
    if (searchBox) searchBox.value = st.q;
    if (sortSelect) sortSelect.value = st.sort;

    // Open controls if there's a query in URL so user understands why pager hides
    if (controlsPanel && st.q) controlsPanel.hidden = false;

    applyAll(false);
  })();
</script>
