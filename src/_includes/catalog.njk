{% set whatsapp_main = "919567883837" %}
{% set order_email = "chiraath.official@hotmail.com" %}

<style>
  :root{--text:#111;--muted:rgba(0,0,0,.65);--border:#eee;--border2:#ddd;--chip:#f7f7f7}
  *{box-sizing:border-box}

  body{
    margin:0;
    font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    background: linear-gradient(180deg, #faf7f2 0%, #ffffff 55%, #fbfbfb 100%);
    color:var(--text);
  }

  .wrap{
    max-width:980px;
    margin:14px auto 18px;
    padding:16px;
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 22px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }

.cover{
  width:100%;
  height:auto;
  aspect-ratio: 16 / 7;
  object-fit: cover;
  object-position: 50% 28%;
  border-radius:18px;
  border:1px solid rgba(0,0,0,0.08);
  margin-bottom:12px;
}

@media(min-width:768px){
  .cover{ height:300px; }
}

  .muted{color:var(--muted)}

  .btn{
    display:block;
    padding:12px;
    border:1px solid var(--border2);
    border-radius:14px;
    text-align:center;
    text-decoration:none;
    color:var(--text);
    margin-bottom:10px;
    font-weight:800;
    background:#fff;
  }

  .btn.whatsapp{
    background:#25D366;
    border-color:#25D366;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
  }
  .btn.whatsapp:hover{filter: brightness(0.95);}
  .btn.whatsapp svg{width:18px;height:18px;fill:#fff;flex:0 0 auto;}

  .chips{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 6px}
  .chipbtn{
    appearance:none;
    background:var(--chip);
    border:1px solid var(--border);
    border-radius:999px;
    padding:9px 12px;
    font-size:13px;
    font-weight:750;
    cursor:pointer;
  }
  .chipbtn.active{background:#111;color:#fff;border-color:#111}

  /* ===== Tabs + icons (same row) ===== */
  .chipbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin:12px 0 10px;
  }
  .chip-actions{display:flex; gap:8px; flex:0 0 auto;}
  .iconbtn{
    width:40px;
    height:40px;
    border-radius:12px;
    border:1px solid rgba(0,0,0,.10);
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    box-shadow: 0 6px 14px rgba(0,0,0,.06);
  }
  .iconbtn svg{width:18px;height:18px}
  @media(max-width:520px){ .iconbtn{ width:38px; height:38px; } }

  /* Panel shown when user taps icons */
  .controls-panel{
    border:1px solid rgba(0,0,0,.08);
    border-radius:16px;
    background:#fff;
    padding:12px;
    box-shadow: 0 10px 22px rgba(0,0,0,.06);
    margin:0 0 12px;
  }
  /* ===== Controls layout: single row (Search + Clear + Sort) ===== */
.controls{
  display:flex;
  gap:12px;
  align-items:flex-end;      /* makes label + field align nicely */
  flex-wrap:wrap;
}

.control{
  flex:1;
  min-width:260px;
}

.control-sort{
  flex:0 0 240px;            /* elegant fixed width */
  min-width:220px;
}

/* Search row: input + clear on same line */
.searchrow{
  display:flex;
  gap:10px;
  align-items:center;
}

#searchBox{
  flex:1;
  min-width:0;
}

.mini-clear{
  margin-top:0;                 /* keep it aligned in-row */
  border:1px solid rgba(0,0,0,.12);
  background:#fff;
  border-radius:999px;
  padding:6px 12px;             /* smaller */
  font-size:13px;               /* smaller */
  font-weight:800;              /* still bold, but not huge */
  cursor:pointer;
  height:40px;                  /* match input height */
  white-space:nowrap;
}

/* Mobile: stack neatly */
@media (max-width: 720px){
  .controls{flex-wrap:wrap;}
  .control-sort{flex:1 1 240px;}
}
  .control-sort .label{
  margin-bottom:4px;
}
  .label{font-weight:900; font-size:12px; margin:0 0 6px; color:var(--muted)}
  .mini-clear{
    margin-top:8px;
    border:1px solid rgba(0,0,0,.12);
    background:#fff;
    border-radius:999px;
    padding:8px 12px;
    font-weight:900;
    cursor:pointer;
  }
 .global-info{
  margin:0 0 12px;
  padding:10px 12px;
  border:1px solid rgba(0,0,0,.08);
  border-radius:14px;
  background: rgba(250,247,242,.85);
  font-weight:800;
  color: rgba(0,0,0,.75);
}

  .search{margin:10px 0 8px}
  .search input{
    width:100%;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:14px;
    font-size:14px;
    background:#fff;
  }

  .sortselect{
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:14px;
    font-size:14px;
    background:#fff;
    font-weight:700;
  }

  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  @media(min-width:768px){.grid{grid-template-columns:repeat(3,1fr)}}
  @media(min-width:1024px){.grid{grid-template-columns:repeat(4,1fr)}}

  .cardlink{color:inherit;text-decoration:none;display:block}
  .card{
    border:1px solid var(--border);
    border-radius:16px;
    padding:10px;
    background:#fff;
  }
  .card:hover{border-color:#d7d7d7}

  .imgwrap{position:relative}
  .card img{
    width:100%;
    aspect-ratio:4/5;
    object-fit:cover;
    object-position:50% 18%;
    border-radius:12px;
    background:#f3f3f3;
    opacity:0;
    transition:opacity 0.35s ease;
  }
  .card img.img-loaded{opacity:1}

  .oos{
    position:absolute;
    top:10px;
    left:10px;
    background:#111;
    color:#fff;
    font-size:12px;
    font-weight:900;
    border-radius:999px;
    padding:6px 10px;
  }

  .code{font-size:12px;color:var(--muted);margin-top:8px}
  .price{margin-top:6px}
  .old{text-decoration:line-through;color:var(--muted);margin-right:8px}

  .title{font-size:15px;font-weight:600;line-height:1.3;}
</style>

