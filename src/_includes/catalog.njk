</svg>
    WhatsApp Order
  </a>
{% endif %}

{% if pagination.pageNumber == 0 and page.url != '/sarees/' and page.url != '/salwars/' %}
  {% if collections.productsNewThisWeek and collections.productsNewThisWeek.length %}
  <div class="new-week-wrap">
    <div class="new-week-head">
      <span class="new-week-title">✨ New this week</span>
    </div>
    <div class="new-week-scroll">
      {% for p in collections.productsNewThisWeek %}
        {% if p.data.images and p.data.images.length %}
          {% set hero = p.data.images[0] %}
        {% else %}
          {% set hero = p.data.image or '/images/cover.jpg' %}
        {% endif %}
        <a class="nw-card" href="{{ p.url }}">
          <div class="nw-img">
            <img src="{{ hero }}" alt="{{ p.data.title }}" loading="lazy" decoding="async">
          </div>
          <div class="nw-title">{{ p.data.title }}</div>
          <div class="nw-price">
            {% if p.data.offer_price %}<span class="old">₹{{ p.data.price }}</span> <strong>₹{{ p.data.offer_price }}</strong>
            {% else %}<strong>₹{{ p.data.price }}</strong>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
{% endif %}

<div class="chipbar">
  <div class="chips">
    <a class="chipbtn {% if page.url == '/' or page.url == '/index.html' %}active{% endif %}" href="/">All</a>
    <a class="chipbtn {% if page.url.startsWith('/sarees') %}active{% endif %}" href="/sarees/">Sarees</a>
    <a class="chipbtn {% if page.url.startsWith('/salwars') %}active{% endif %}" href="/salwars/">Salwars</a>
    {% set hasNewProducts = false %}
    {% for p in collections.productsSorted %}
      {% if p.data.tags and ('New' in p.data.tags) %}{% set hasNewProducts = true %}{% endif %}
    {% endfor %}
    {% if hasNewProducts %}
    <button class="chipbtn fchip fchip--new" data-filter="New" type="button"><em>New!</em> Collections</button>
    {% endif %}
    <button class="chipbtn fchip" data-filter="Under ₹1000" type="button">Under ₹1000</button>
  </div>

  <div class="chip-actions">
    <button class="iconbtn" id="searchToggle" type="button" aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M10 18a8 8 0 1 1 5.3-14.1A8 8 0 0 1 10 18zm11 3-6.2-6.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <button class="iconbtn" id="sortToggle" type="button" aria-label="Sort">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<div id="controlsPanel" class="controls-panel" hidden>
  <div class="controls">
<div class="control">
  <div class="label">Search</div>
  <div class="searchrow">
    <input id="searchBox" type="search" placeholder="Name, code, or color…" autocomplete="off">
    <button class="mini-clear" id="clearSearch" type="button">Clear</button>
  </div>
</div>

    <div class="control control-sort">
      <div class="label" id="sortLabel">Sort results</div>
      <select id="sortSelect" class="sortselect">
        <option value="newest" selected>Newest (Default)</option>
        <option value="price_low">Price: Low to High</option>
        <option value="price_high">Price: High to Low</option>
        <option value="name_az">Name: A to Z</option>
      </select>
    </div>
  </div>
</div>

  {% macro card(p) %}
    {% if p.data.images and p.data.images.length %}
  {% set hero = p.data.images[0] %}
{% else %}
  {% set hero = p.data.image %}
{% endif %}
    <div class="card" data-color="{{ p.data.color }}">
      <div class="imgwrap">
        {% if hero %}
          <img src="{{ hero }}" alt="{{ p.data.title }}" loading="lazy" decoding="async">
        {% else %}
          <img src="/images/cover.jpg" alt="{{ p.data.title }}" loading="lazy" decoding="async">
        {% endif %}
        {% if p.data.in_stock == false %}
          <div class="oos">Out of stock</div>
        {% elif p.data.stock_count and p.data.stock_count <= 5 %}
          <div class="badge-low">Only {{ p.data.stock_count }} left</div>
        {% endif %}
        {% if p.data.date | isNew %}
          <div class="badge-new">New</div>
        {% endif %}
      </div>

      <div class="code">{{ p.data.code }}</div>
      <div class="title">{{ p.data.title }}</div>

      <div class="price">
        {% if p.data.offer_price %}
          <span class="old">₹{{ p.data.price }}</span><strong>₹{{ p.data.offer_price }}</strong>
        {% else %}
          <strong>₹{{ p.data.price }}</strong>
        {% endif %}
      </div>
      <div class="swatches"></div>
    </div>
  {% endmacro %}

{# ===== Global dataset for global search (ALL products) ===== #}
<script id="allProductsJson" type="application/json">
[
{% set first = true %}
{% for p in collections.productsSorted %}
  {% if not p.data.hidden %}
    {% if not first %},{% endif %}
    {% set first = false %}
    {
      "code": {{ (p.data.code or "") | dump | safe }},
      "title": {{ (p.data.title or "") | dump | safe }},
      "category": {{ (p.data.category or "") | dump | safe }},
      "url": {{ (p.url or "") | dump | safe }},
      "in_stock": {{ (p.data.in_stock != false) | dump | safe }},
      "base_price": {{ (p.data.price or 0) | dump | safe }},
      "offer_price": {{ (p.data.offer_price or 0) | dump | safe }},
      "price": {{ (p.data.offer_price or p.data.price or 0) | dump | safe }},
      "image": {{ ((p.data.images and p.data.images[0]) or p.data.image or "") | dump | safe }},
      "date": {{ (p.data.date or "") | dump | safe }},
      "stock_count": {{ (p.data.stock_count or 0) | dump | safe }},
      "orig": {{ loop.index0 | dump | safe }},
      "tags": {{ (p.data.tags or []) | dump | safe }},
      "color": {{ (p.data.color or "") | dump | safe }}
    }
  {% endif %}
{% endfor %}
]
</script>


<div id="globalInfo" class="global-info" hidden></div>

  <div class="grid">
  {% for p in prods %}
    {% if not p.data.hidden %}
      {% set displayPrice = p.data.offer_price or p.data.price or 0 %}
      <div class="product-item"
           data-category="{{ p.data.category }}"
           data-stock="{% if p.data.in_stock == false %}0{% else %}1{% endif %}"
           data-search="{{ (p.data.code ~ ' ' ~ p.data.title) | lower }}"
           data-title="{{ (p.data.title or '') | lower }}"
           data-price="{{ displayPrice }}"
           data-orig="{{ loop.index0 }}"
           data-tags="{{ p.data.tags | join(',') if p.data.tags else '' }}">
        <a class="cardlink" href="{{ p.url }}">{{ card(p) }}</a>
      </div>
    {% endif %}
  {% endfor %}
  </div>

<nav id="pager" style="margin-top:16px; display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
  {% if pagination.href.previous %}
    <a class="btn" data-page-link style="max-width:140px" href="{{ pagination.href.previous }}">← Prev</a>
  {% endif %}

  {% for href in pagination.hrefs %}
    {% set pageNum = loop.index %}
    <a class="btn" data-page-link
       style="max-width:60px; padding:10px 0; {% if pagination.pageNumber == loop.index0 %}background:#111;color:#fff;border-color:#111{% endif %}"
       href="{{ href }}">
      {{ pageNum }}
    </a>
  {% endfor %}

  {% if pagination.href.next %}
    <a class="btn" data-page-link style="max-width:140px" href="{{ pagination.href.next }}">Next →</a>
  {% endif %}
</nav>

  <div style="margin-top:28px">
    {% include "black-footer.njk" %}
  </div>

</div>

<!-- Back to top button -->
<button class="back-top" id="backTop" aria-label="Back to top">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<script>
  const grid = document.querySelector('.grid');
  const pager = document.getElementById('pager');
  const globalInfo = document.getElementById('globalInfo');

  const controlsPanel = document.getElementById('controlsPanel');
  const searchToggle = document.getElementById('searchToggle');
  const sortToggle = document.getElementById('sortToggle');
  const searchBox = document.getElementById('searchBox');
  const sortSelect = document.getElementById('sortSelect');
  const sortLabel = document.getElementById('sortLabel');
  const clearBtn = document.getElementById('clearSearch');

  // Save original paginated markup so we can restore without breaking anything
  const originalGridHTML = grid ? grid.innerHTML : '';
  const originalPagerDisplay = pager ? (pager.style.display || '') : '';

  // Parse the global dataset safely (rendered by Eleventy at build time)
  let ALL = [];
  try {
    ALL = JSON.parse(document.getElementById('allProductsJson')?.textContent || '[]');
    if (!Array.isArray(ALL)) ALL = [];
  } catch (e) {
    ALL = [];
  }

  // ===== Tag filter chip (Under ₹1000) =====
  let activeFilter = 'all';
  const filterBtns = document.querySelectorAll('.fchip[data-filter]');

  function renderTagFilter(tag){
    if (!grid) return;
    const matches = ALL.filter(p => Array.isArray(p.tags) && p.tags.includes(tag));

    grid.innerHTML = '';

    if (matches.length === 0) {
      grid.innerHTML = `<div style="grid-column:1/-1;padding:40px 16px;text-align:center;color:var(--muted)"><div style="font-size:2rem;margin-bottom:8px">🔍</div><div style="font-weight:800;font-size:15px">No products found</div></div>`;
      setMode(true, tag);
      return;
    }

    matches.forEach(p => {
      const inStock = (p.in_stock !== false);
      const stock = inStock ? 1 : 0;
      const basePrice = Number(p.base_price || 0);
      const offerPrice = Number(p.offer_price || 0);
      const displayPrice = offerPrice > 0 ? offerPrice : basePrice;
      const title = String(p.title || '');
      const code = String(p.code || '');
      const img = p.image || '/images/cover.jpg';
      const orig = Number(p.orig || 0);
      const priceHtml = offerPrice > 0
        ? `<span class="old">₹${basePrice}</span><strong>₹${offerPrice}</strong>`
        : `<strong>₹${basePrice}</strong>`;
      const isNew = p.date && ((Date.now() - new Date(p.date)) / 86400000) <= 14;
      const stockCount = Number(p.stock_count || 0);
      const leftBadge = inStock
        ? (stockCount > 0 && stockCount <= 5 ? `<div class="badge-low">Only ${stockCount} left</div>` : '')
        : '<div class="oos">Out of stock</div>';
      const newBadge = isNew ? '<div class="badge-new">New</div>' : '';

      const color = String(p.color || '');
      grid.insertAdjacentHTML('beforeend', `
        <div class="product-item" data-stock="${stock}" data-title="${title.toLowerCase()}" data-search="${(code+' '+title).toLowerCase()}" data-price="${displayPrice}" data-orig="${orig}">
          <a class="cardlink" href="${p.url}">
            <div class="card" data-color="${color}">
              <div class="imgwrap"><img src="${img}" alt="${title}" loading="lazy" decoding="async">${leftBadge}${newBadge}</div>
              <div class="code">${code}</div>
              <div class="title">${title}</div>
              <div class="price">${priceHtml}</div>
              <div class="swatches"></div>
            </div>
          </a>
        </div>`);
    });

    setMode(true, tag);
    renderSwatches(grid);
    applySort();
    applyFadeIn(grid);
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const isActive = btn.classList.contains('active');
      filterBtns.forEach(b => b.classList.remove('active'));
      if (isActive) {
        activeFilter = 'all';
        restorePage();
      } else {
        btn.classList.add('active');
        activeFilter = btn.dataset.filter;
        renderTagFilter(activeFilter);
      }
    });
  });

  function getItems(){
    return grid ? Array.from(grid.querySelectorAll('.product-item')) : [];
  }

  // ===== Color swatches =====
  const COLOR_MAP = {
    'black':'#1a1a1a','white':'#f5f0e8','red':'#c0392b','maroon':'#800000',
    'pink':'#e879a0','rose':'#e8638a','coral':'#e8856a','peach':'#ffcba4',
    'orange':'#e8722a','rust':'#b7410e','yellow':'#f1c40f','mustard':'#e3a832','golden':'#d4af37','gold':'#d4af37',
    'green':'#4a8c4f','olive':'#6b7a44','emerald':'#2ecc71','mint':'#98d8c8','teal':'#008080','turquoise':'#40e0d0','aqua':'#00bcd4',
    'blue':'#4a7fc1','indigo':'#3949ab','navy':'#1a2a6c',
    'purple':'#7d3c98','violet':'#7d3c98','lavender':'#967bb6',
    'brown':'#7b4b2a','beige':'#f5f0e8','cream':'#fdf7e3','ivory':'#f5f0e8',
    'grey':'#9e9e9e','gray':'#9e9e9e','silver':'#c0c0c0',
  };

  function parseSwatches(colorStr){
    if (!colorStr) return [];
    const lower = colorStr.toLowerCase();
    const found = [];
    for (const [name, hex] of Object.entries(COLOR_MAP)){
      if (lower.includes(name) && !found.find(f => f.hex === hex)){
        found.push({name, hex});
      }
    }
    return found;
  }

  function renderSwatches(root){
    (root || document).querySelectorAll('.card[data-color]').forEach(card => {
      const el = card.querySelector('.swatches');
      if (!el || el.children.length > 0) return;
      const colors = parseSwatches(card.dataset.color);
      if (!colors.length) return;
      const shown = colors.slice(0, 5);
      const extra = colors.length - shown.length;
      shown.forEach(c => {
        const s = document.createElement('span');
        s.className = 'swatch';
        s.style.background = c.hex;
        s.title = c.name;
        el.appendChild(s);
      });
      if (extra > 0){
        const m = document.createElement('span');
        m.className = 'swatch-more';
        m.textContent = `+${extra}`;
        el.appendChild(m);
      }
    });
  }

  function applyFadeIn(root) {
    (root || document).querySelectorAll('.card img').forEach(img => {
      if (img.complete && img.naturalWidth > 0) {
        img.classList.add('img-loaded');
      } else {
        img.addEventListener('load', () => img.classList.add('img-loaded'), { once: true });
      }
    });
  }

  function applySort(){
    if (!grid || !sortSelect) return;

    const mode = sortSelect.value || 'newest';
    const items = getItems();

    const sorted = [...items].sort((a,b) => {
      // in-stock first
      const aStock = Number(a.dataset.stock || '1');
      const bStock = Number(b.dataset.stock || '1');
      if (aStock !== bStock) return bStock - aStock;

      if (mode === 'price_low') {
        return Number(a.dataset.price || '0') - Number(b.dataset.price || '0');
      }
      if (mode === 'price_high') {
        return Number(b.dataset.price || '0') - Number(a.dataset.price || '0');
      }
      if (mode === 'name_az') {
        return String(a.dataset.title || '').localeCompare(String(b.dataset.title || ''));
      }

      // newest (default): lower orig first
      return Number(a.dataset.orig || '0') - Number(b.dataset.orig || '0');
    });

    sorted.forEach(el => grid.appendChild(el));
    applyFadeIn(grid);
  }

  function setMode(isGlobal, q){
    if (pager) pager.style.display = isGlobal ? 'none' : (originalPagerDisplay || 'flex');

    if (globalInfo) {
      globalInfo.hidden = !isGlobal;
      if (isGlobal) {
        const count = getItems().length;
        globalInfo.textContent = count === 0
          ? `No products found for "${q}"`
          : `${count} result${count !== 1 ? 's' : ''} for "${q}"`;
      }
    }

    if (sortLabel) sortLabel.textContent = 'Sort results';
  }

  function restorePage(){
    if (!grid) return;
    grid.innerHTML = originalGridHTML;
    if (globalInfo) globalInfo.hidden = true;
    setMode(false, '');
    applySort();
  }

  function renderGlobal(q){
    if (!grid) return;

    const query = (q || '').trim().toLowerCase();
    if (!query) {
      restorePage();
      return;
    }

    const matches = ALL.filter(p => {
      const text = `${p.code || ''} ${p.title || ''}`.toLowerCase();
      return text.includes(query);
    });

    grid.innerHTML = '';

    if (matches.length === 0) {
      grid.innerHTML = `<div style="grid-column:1/-1;padding:40px 16px;text-align:center;color:var(--muted)"><div style="font-size:2rem;margin-bottom:8px">🔍</div><div style="font-weight:800;font-size:15px">No products found</div><div style="font-size:13px;margin-top:4px">Try a different name or product code</div></div>`;
      setMode(true, q);
      return;
    }

    matches.forEach(p => {
      const inStock = (p.in_stock !== false);
      const stock = inStock ? 1 : 0;

      const basePrice = Number(p.base_price || 0);
      const offerPrice = Number(p.offer_price || 0);
      const displayPrice = offerPrice > 0 ? offerPrice : basePrice;

      const title = String(p.title || '');
      const code = String(p.code || '');
      const img = p.image || '/images/cover.jpg';
      const orig = Number(p.orig || 0);

      const priceHtml = offerPrice > 0
        ? `<span class="old">₹${basePrice}</span><strong>₹${offerPrice}</strong>`
        : `<strong>₹${basePrice}</strong>`;

      const isNew = p.date && ((Date.now() - new Date(p.date)) / 86400000) <= 14;
      const stockCount = Number(p.stock_count || 0);
      const leftBadge = inStock
        ? (stockCount > 0 && stockCount <= 5 ? `<div class="badge-low">Only ${stockCount} left</div>` : '')
        : '<div class="oos">Out of stock</div>';
      const newBadge = isNew ? '<div class="badge-new">New</div>' : '';

      const color = String(p.color || '');
      const html = `
        <div class="product-item"
             data-stock="${stock}"
             data-title="${title.toLowerCase()}"
             data-search="${(code + ' ' + title).toLowerCase()}"
             data-price="${displayPrice}"
             data-orig="${orig}">
          <a class="cardlink" href="${p.url}">
            <div class="card" data-color="${color}">
              <div class="imgwrap">
                <img src="${img}" alt="${title}" loading="lazy" decoding="async">
                ${leftBadge}${newBadge}
              </div>
              <div class="code">${code}</div>
              <div class="title">${title}</div>
              <div class="price">${priceHtml}</div>
              <div class="swatches"></div>
            </div>
          </a>
        </div>
      `;
      grid.insertAdjacentHTML('beforeend', html);
    });

    setMode(true, q);
    applySort();
    renderSwatches(grid);
  }

  function getStateFromUrl(){
    const p = new URLSearchParams(window.location.search);
    return {
      q: (p.get('q') || '').trim(),
      sort: p.get('sort') || 'newest',
    };
  }

  function setStateToUrl(q, sort){
    const p = new URLSearchParams();
    if (q && q.trim()) p.set('q', q.trim());
    if (sort && sort !== 'newest') p.set('sort', sort);

    const qs = p.toString();
    const newUrl = window.location.pathname + (qs ? `?${qs}` : '');
    history.replaceState(null, '', newUrl);

    // Preserve query params when clicking pagination (normal mode)
    document.querySelectorAll('a[data-page-link]').forEach(a => {
      const base = a.getAttribute('href').split('?')[0];
      a.setAttribute('href', base + (qs ? `?${qs}` : ''));
    });
  }

  function applyAll(pushUrl=true){
    const q = (searchBox?.value || '').trim();
    const sort = sortSelect?.value || 'newest';

    if (q) renderGlobal(q);
    else restorePage();

    if (pushUrl) setStateToUrl(q, sort);
  }

  // Controls panel behavior
function toggleControls(focusEl){
  if (!controlsPanel) return;

  const willOpen = controlsPanel.hidden;
  controlsPanel.hidden = !willOpen;

  if (willOpen && focusEl){
    setTimeout(() => {
      focusEl.focus();
      // Premium: select existing text so user can just type and replace
      if (typeof focusEl.select === 'function') focusEl.select();
    }, 0);
  }
}

  searchToggle?.addEventListener('click', () => toggleControls(searchBox));
  sortToggle?.addEventListener('click', () => toggleControls(sortSelect));
  clearBtn?.addEventListener('click', () => {
    if (searchBox) searchBox.value = '';
    applyAll(true);
  });

  searchBox?.addEventListener('input', () => applyAll(true));
  sortSelect?.addEventListener('change', () => applyAll(true));

  // Smooth scroll to top on pagination click
  document.querySelectorAll('[data-page-link]').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const href = a.getAttribute('href');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => { window.location.href = href; }, 320);
    });
  });

  // Back to top
  const backTop = document.getElementById('backTop');
  window.addEventListener('scroll', () => {
    backTop?.classList.toggle('visible', window.scrollY > 400);
  }, { passive: true });
  backTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  // Init from URL
  (function init(){
    const st = getStateFromUrl();
    if (searchBox) searchBox.value = st.q;
    if (sortSelect) sortSelect.value = st.sort;

    // Open controls if there's a query in URL so user understands why pager hides
    if (controlsPanel && st.q) controlsPanel.hidden = false;

    applyAll(false);
    renderSwatches();
  })();
</script>

