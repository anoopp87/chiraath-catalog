<style>
.wa-float{
  position:fixed;
  right:18px;
  bottom:18px;
  width:64px;
  height:64px;
  background:#25D366;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:9999;
  box-shadow:0 10px 24px rgba(0,0,0,.28);
  transition:transform .2s ease, box-shadow .2s ease;
}

.wa-float svg{
  width:32px;
  height:32px;
  display:block;
}

.wa-float:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 30px rgba(0,0,0,.32);
}
/* ===== Premium Polish (Index) ===== */
:root{
  --radius-xl: 22px;
  --radius-lg: 18px;
  --radius-md: 14px;
  --shadow-soft: 0 12px 30px rgba(0,0,0,.08);
  --shadow-card: 0 10px 24px rgba(0,0,0,.10);
  --border-soft: rgba(0,0,0,.08);
  --border-softer: rgba(0,0,0,.06);
}

.wrap{
  background: rgba(255,255,255,.86);
  border: 1px solid var(--border-softer);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(8px);
}

.cover{
  height: auto;
  aspect-ratio: 16 / 6;          /* Premium banner ratio */
  object-fit: cover;
  object-position: 50% 22%;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-soft);
}

.btn{
  border-radius: var(--radius-md);
  border: 1px solid var(--border-soft);
  box-shadow: 0 6px 16px rgba(0,0,0,.06);
  transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
}
.btn:hover{
  transform: translateY(-1px);
  box-shadow: 0 10px 24px rgba(0,0,0,.10);
}

.btn.whatsapp{
  box-shadow: 0 10px 22px rgba(37,211,102,.25);
}
.btn.whatsapp:hover{
  filter: brightness(.97);
  box-shadow: 0 14px 28px rgba(37,211,102,.30);
}

.chipbtn{
  border: 1px solid var(--border-soft);
  background: rgba(255,255,255,.92);
  box-shadow: 0 6px 14px rgba(0,0,0,.06);
  transition: transform .12s ease, box-shadow .12s ease;
}
.chipbtn:hover{
  transform: translateY(-1px);
  box-shadow: 0 10px 20px rgba(0,0,0,.10);
}
.chipbtn.active{
  box-shadow: 0 12px 24px rgba(0,0,0,.16);
}
.controls{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin:10px 0 12px;
}

.control{flex:1; min-width:220px}
.control-sort{flex:0 0 220px}

.ctl-label{
  font-weight:800;
  font-size:12px;
  margin:0 0 6px;
}

.ctl-input{
  width:100%;
  padding:12px 14px;
  border:1px solid var(--border);
  border-radius:14px;
  font-size:14px;
  background:#fff;
}
.search input,
.sortselect{
  border: 1px solid var(--border-soft);
  box-shadow: 0 8px 18px rgba(0,0,0,.06);
  transition: box-shadow .12s ease, border-color .12s ease;
}
.search input:focus,
.sortselect:focus{
  outline: none;
  border-color: rgba(0,0,0,.18);
  box-shadow: 0 14px 28px rgba(0,0,0,.10);
}

.grid{ gap: 14px; }

.card{
  border: 1px solid var(--border-softer);
  border-radius: 18px;
  padding: 12px;
  box-shadow: 0 8px 18px rgba(0,0,0,.06);
  transition: transform .14s ease, box-shadow .14s ease, border-color .14s ease;
}
.card:hover{
  transform: translateY(-2px);
  box-shadow: var(--shadow-card);
  border-color: rgba(0,0,0,.10);
}
.card img{
  border-radius: 14px;
  border: 1px solid rgba(0,0,0,.06);
}

.title{ font-size: 15px; font-weight: 700; letter-spacing: .1px; }
.price-main{ font-weight: 900; }
.code{ letter-spacing: .2px; }
.chipbtn{
  text-decoration:none;
  color:inherit;
  display:inline-block;
}
</style>
