{% set whatsapp_main = "919567883837" %}
{% set order_email = "chiraath.official@hotmail.com" %}

<style>
  :root{--text:#111;--muted:rgba(0,0,0,.65);--border:#eee;--border2:#ddd;--chip:#f7f7f7}
  *{box-sizing:border-box}

  body{
    margin:0;
    font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    background: linear-gradient(180deg, #faf7f2 0%, #ffffff 55%, #fbfbfb 100%);
    color:var(--text);
  }

  .wrap{
    max-width:980px;
    margin:14px auto 18px;
    padding:16px;
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 22px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }

.cover{
  width:100%;
  height:auto;
  aspect-ratio: 16 / 7;
  object-fit: cover;
  object-position: 50% 28%;
  border-radius:18px;
  border:1px solid rgba(0,0,0,0.08);
  margin-bottom:12px;
}

@media(min-width:768px){
  .cover{ height:300px; }
}

  .muted{color:var(--muted)}

  .promise-bar{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:6px 18px;
    padding:9px 12px;
    background:rgba(250,247,242,0.85);
    border:1px solid rgba(0,0,0,0.06);
    border-radius:12px;
    font-size:12px;
    font-weight:700;
    color:rgba(0,0,0,0.65);
    margin-bottom:12px;
  }

  .btn{
    display:block;
    padding:12px;
    border:1px solid var(--border2);
    border-radius:14px;
    text-align:center;
    text-decoration:none;
    color:var(--text);
    margin-bottom:10px;
    font-weight:800;
    background:#fff;
  }

  .btn.whatsapp{
    background:#25D366;
    border-color:#25D366;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
  }
  .btn.whatsapp:hover{filter: brightness(0.95);}
  .btn.whatsapp svg{width:18px;height:18px;fill:#fff;flex:0 0 auto;}

  .chips{display:flex;gap:8px;flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin:12px 0 6px;min-width:0}
  .chips::-webkit-scrollbar{display:none}
  .chipbtn{
    appearance:none;
    background:var(--chip);
    border:1px solid var(--border);
    border-radius:999px;
    padding:9px 12px;
    font-size:13px;
    font-weight:750;
    cursor:pointer;
  }
  .chipbtn.active{background:#111;color:#fff;border-color:#111}
  .fchip--new em{font-style:italic;font-family:Georgia,serif;font-weight:700;letter-spacing:.3px}
  .fchip--new{border-color:#c9a96e;color:#7a4f1e}
  .fchip--new.active{background:#7a4f1e;border-color:#7a4f1e;color:#fff}
  /* ===== Color swatches ===== */
  .swatches{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap;min-height:16px}
  .swatch{width:14px;height:14px;border-radius:50%;border:1.5px solid rgba(0,0,0,0.15);flex-shrink:0;display:inline-block}
  .swatch-more{font-size:10px;color:var(--muted);align-self:center;font-weight:700;margin-left:1px}

  /* ===== Tabs + icons (same row) ===== */
  .chipbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin:12px 0 10px;
    position:sticky;
    top:8px;
    z-index:100;
    background:rgba(255,255,255,0.90);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border-radius:14px;
    padding:4px 6px;
  }
  .chip-actions{display:flex; gap:8px; flex:0 0 auto;}
  .iconbtn{
    width:40px;
    height:40px;
    border-radius:12px;
    border:1px solid rgba(0,0,0,.10);
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    box-shadow: 0 6px 14px rgba(0,0,0,.06);
  }
  .iconbtn svg{width:18px;height:18px}
  @media(max-width:520px){ .iconbtn{ width:38px; height:38px; } }

  /* Panel shown when user taps icons */
  .controls-panel{
    border:1px solid rgba(0,0,0,.08);
    border-radius:16px;
    background:#fff;
    padding:12px;
    box-shadow: 0 10px 22px rgba(0,0,0,.06);
    margin:0 0 12px;
  }
  /* ===== Controls layout: single row (Search + Clear + Sort) ===== */
.controls{
  display:flex;
  gap:12px;
  align-items:flex-end;      /* makes label + field align nicely */
  flex-wrap:wrap;
}

.control{
  flex:1;
  min-width:260px;
}

.control-sort{
  flex:0 0 240px;            /* elegant fixed width */
  min-width:220px;
}

/* Search row: input + clear on same line */
.searchrow{
  display:flex;
  gap:10px;
  align-items:center;
}

#searchBox{
  flex:1;
  min-width:0;
}

.mini-clear{
  margin-top:0;                 /* keep it aligned in-row */
  border:1px solid rgba(0,0,0,.12);
  background:#fff;
  border-radius:999px;
  padding:6px 12px;             /* smaller */
  font-size:13px;               /* smaller */
  font-weight:800;              /* still bold, but not huge */
  cursor:pointer;
  height:40px;                  /* match input height */
  white-space:nowrap;
}

/* Mobile: stack neatly */
@media (max-width: 720px){
  .controls{flex-wrap:wrap;}
  .control-sort{flex:1 1 240px;}
}
  .control-sort .label{
  margin-bottom:4px;
}
  .label{font-weight:900; font-size:12px; margin:0 0 6px; color:var(--muted)}
  .mini-clear{
    margin-top:8px;
    border:1px solid rgba(0,0,0,.12);
    background:#fff;
    border-radius:999px;
    padding:8px 12px;
    font-weight:900;
    cursor:pointer;
  }
 .global-info{
  margin:0 0 12px;
  padding:10px 12px;
  border:1px solid rgba(0,0,0,.08);
  border-radius:14px;
  background: rgba(250,247,242,.85);
  font-weight:800;
  color: rgba(0,0,0,.75);
}

  .search{margin:10px 0 8px}
  .search input{
    width:100%;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:14px;
    font-size:14px;
    background:#fff;
  }

  .sortselect{
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:14px;
    font-size:14px;
    background:#fff;
    font-weight:700;
  }

  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  @media(min-width:768px){.grid{grid-template-columns:repeat(3,1fr)}}
  @media(min-width:1024px){.grid{grid-template-columns:repeat(4,1fr)}}

  .cardlink{
    color:inherit;
    text-decoration:none;
    display:block;
    transition:transform 0.15s ease;
  }
  .card{
    border:1px solid var(--border);
    border-radius:16px;
    padding:10px;
    background:#fff;
    transition:border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .cardlink:hover{transform:translateY(-3px)}
  .cardlink:hover .card{
    border-color:#ccc;
    box-shadow:0 10px 24px rgba(0,0,0,0.10);
  }

  .imgwrap{position:relative}
  .card img{
    width:100%;
    aspect-ratio:4/5;
    object-fit:cover;
    object-position:50% 18%;
    border-radius:12px;
    background:#f3f3f3;
    opacity:0;
    transition:opacity 0.35s ease;
  }
  .card img.img-loaded{opacity:1}

  .oos,.badge-low,.badge-new{
    position:absolute;
    font-size:11px;
    font-weight:900;
    border-radius:999px;
    padding:5px 10px;
    line-height:1;
  }
  .oos{top:10px;left:10px;background:#111;color:#fff}
  .badge-low{top:10px;left:10px;background:#e8521a;color:#fff}
  .badge-new{top:10px;right:10px;background:#b8860b;color:#fff;letter-spacing:.03em}

  .code{
    display:inline-block;
    font-size:11px;
    font-weight:800;
    color:var(--muted);
    background:var(--chip);
    border:1px solid var(--border);
    border-radius:6px;
    padding:2px 7px;
    margin-top:8px;
    letter-spacing:0.03em;
  }
  .price{margin-top:6px;display:flex;align-items:baseline;flex-wrap:wrap;gap:4px}
  .price strong{font-size:15px;font-weight:800}
  .old{text-decoration:line-through;color:var(--muted);font-size:12px}

  .title{font-size:15px;font-weight:600;line-height:1.3;}

  @media(max-width:400px){
    .wrap{padding:10px}
    .grid{gap:8px}
    .card{padding:8px}
    .title{font-size:14px}
  }

  /* ===== How to Order strip ===== */
  .howtobuy{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:12px;
    background:rgba(250,247,242,0.8);
    border:1px solid rgba(0,0,0,0.06);
    border-radius:14px;
    margin-bottom:12px;
    flex-wrap:nowrap;
  }
  .howtobuy-step{display:flex;align-items:center;gap:8px;flex-shrink:0}
  .hb-num{
    width:26px;height:26px;
    background:#111;color:#fff;
    border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:12px;font-weight:900;flex-shrink:0;
  }
  .hb-text{font-size:12px;line-height:1.35;color:var(--text)}
  .hb-text strong{font-weight:900;display:block}
  .hb-arrow{color:rgba(0,0,0,.25);font-size:16px;flex-shrink:0}
  @media(max-width:520px){
    .hb-text{font-size:0}
    .hb-text strong{font-size:12px;display:inline;font-weight:700}
    .hb-num{width:22px;height:22px;font-size:11px}
    .howtobuy{gap:6px;padding:10px 12px}
    .howtobuy-step{gap:5px}
    .hb-arrow{font-size:13px}
  }

  /* ===== New this week section ===== */
  .new-week-wrap{margin-bottom:14px}
  .new-week-head{
    display:flex;align-items:center;
    justify-content:space-between;
    margin-bottom:8px;
  }
  .new-week-title{font-size:14px;font-weight:900}
  .new-week-scroll{
    display:flex;gap:10px;
    overflow-x:auto;padding-bottom:4px;
    scrollbar-width:none;
  }
  .new-week-scroll::-webkit-scrollbar{display:none}
  .nw-card{flex:0 0 120px;text-decoration:none;color:inherit}
  .nw-img{
    width:120px;height:150px;
    border-radius:12px;overflow:hidden;
    background:#f3f3f3;
    border:1px solid rgba(0,0,0,.06);
  }
  .nw-img img{
    width:100%;height:100%;
    object-fit:cover;object-position:50% 18%;
    display:block;
    opacity:0;transition:opacity .35s ease;
  }
  .nw-img img.img-loaded{opacity:1}
  .nw-title{font-size:11px;font-weight:600;margin-top:5px;line-height:1.3;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .nw-price{font-size:11px;margin-top:2px;font-weight:800}
</style>

<div class="wrap">

  {% if site.cover %}
    <img class="cover" src="{{ site.cover }}" alt="CHIRAATH cover">
  {% endif %}

  <div class="promise-bar">
    <span>🚚 Free shipping across Kerala</span>
    <span>💬 WhatsApp ordering</span>
    <span>⚡ 48hr dispatch</span>
  </div>


{% if page.url != '/' %}
  <a class="btn whatsapp" href="https://wa.me/{{ whatsapp_main }}" target="_blank" rel="noopener">
<svg viewBox="0 0 24 24" aria-hidden="true">
